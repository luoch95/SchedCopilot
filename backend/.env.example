# Set these in your shell; this file is a configuration example, not auto-loaded.
LLM_API_KEY=
LLM_MODEL=
# Optional: your provider's OpenAI-compatible endpoint.
LLM_BASE_URL=
# Optional: SQLite path; defaults to the repository root .data/injection_molding.sqlite3,
# independent of whether the API is started from the root or backend directory.
SCHED_DB_PATH=
# Optional: frontend build path, mainly for wheel deployments outside the repository.
SCHED_FRONTEND_DIR=
# Optional: application log level. Logs exclude prompts, reasons and provider errors.
SCHED_LOG_LEVEL=INFO
