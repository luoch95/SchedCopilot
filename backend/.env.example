# Copy to the repository root .env, or set these in your shell (shell takes priority).
LLM_API_KEY=
LLM_MODEL=
# Optional: your provider's OpenAI-compatible endpoint.
LLM_BASE_URL=
# auto: use models when configured, otherwise rules. live: attempt models and disclose fallback.
# rules: never call a provider. Applies to the main four-Agent /api/workflow endpoint.
SCHED_WORKFLOW_MODEL_MODE=auto
# chat_completions for compatible providers; responses for OpenAI Responses tool calling.
LLM_API_TYPE=chat_completions
# Per model request, seconds (1-60). Two requests maximum per executed Agent; no retries.
LLM_TIMEOUT_SECONDS=30
# Optional: SQLite path; defaults to the repository root .data/injection_molding.sqlite3,
# independent of whether the API is started from the root or backend directory.
SCHED_DB_PATH=
# Optional: frontend build path, mainly for wheel deployments outside the repository.
SCHED_FRONTEND_DIR=
# Optional: application log level. Logs exclude prompts, reasons and provider errors.
SCHED_LOG_LEVEL=INFO
